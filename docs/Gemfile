source "https://rubygems.org"

# Local preview only — GitHub Pages builds the site remotely on push.
# We use plain Jekyll 4 here because the github-pages gem pins Jekyll 3.9,
# which doesn't run on Ruby 3.2+ (relies on the removed String#tainted?).
gem "jekyll", "~> 4.3"
gem "webrick"

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end
